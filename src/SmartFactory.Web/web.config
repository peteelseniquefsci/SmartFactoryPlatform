<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting (ASP.NET Core Module V2, in-process). `dotnet publish` copies and transforms this file.
     Requires the ASP.NET Core 8 Hosting Bundle on the server. See README: Deploying to IIS on Windows Server. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SmartFactory.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- Excel and CSV imports: allow uploads up to 50 MB. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
