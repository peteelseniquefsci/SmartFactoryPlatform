@model (SlotEvaluation slot, FiscalHalf half, WorkWeek thisWeek, string title)
@{
    var s = Model.slot;
    var weeks = s.Weeks;
    var n = weeks.Count;
    const double W = 640, H = 220, padL = 44, padR = 16, padT = 16, padB = 28;
    var targets = weeks.Select(w => w.Target).ToList();
    var actuals = weeks.Select(w => w.Actual).ToList();
    var maxY = (double)(new[] { targets.Max() ?? 0, actuals.Max() ?? 0, 1m }.Max()) * 1.1;
    double X(int i) => padL + (W - padL - padR) * i / Math.Max(1, n - 1);
    double Y(decimal v) => padT + (H - padT - padB) * (1 - (double)v / maxY);
    string Path(List<decimal?> vals)
    {
        var sb = new System.Text.StringBuilder(); bool pen = false;
        for (int i = 0; i < vals.Count; i++)
        {
            if (vals[i] is null) { pen = false; continue; }
            sb.Append(pen ? " L" : " M").Append(X(i).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)).Append(' ').Append(Y(vals[i]!.Value).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture));
            pen = true;
        }
        return sb.ToString();
    }
    var hereIdx = weeks.FindIndex(w => w.Week.Sequence == Model.thisWeek.Sequence);
    var hereWeek = hereIdx >= 0 ? weeks[hereIdx] : null;
    var hereVal = hereWeek?.Actual ?? (hereIdx > 0 ? weeks.Take(hereIdx).LastOrDefault(w => w.Actual is not null)?.Actual : null);
    var thisMonth = Model.thisWeek.FiscalMonth!;
    var monthEval = s.Month(thisMonth.Index);
    var monthStarts = Model.half.Months.Select(m => weeks.FindIndex(w => w.Week.FiscalMonthId == m.Id)).ToList();
    var pct = s.Slot.Measure.Contains("Score", StringComparison.OrdinalIgnoreCase) || s.Slot.Measure.Contains("%");
}
<div class="panel min-w-0">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2>@Model.title</h2>
            <p class="caption mt-1">@s.Slot.Measure</p>
        </div>
        <div class="text-right">
            <div class="number-xl text-cyan-text">@(hereVal is null ? "—" : Fmt.Num(hereVal, 2))<span class="text-[24px] text-ink-muted">@(pct ? "%" : "")</span></div>
            <div class="caption">now · ramp @Fmt.Num(monthEval?.Plan, 2)@(pct ? "%" : "") by end of @thisMonth.Label</div>
        </div>
    </div>
    <div class="mt-4 overflow-x-auto">
        <svg viewBox="0 0 @W @H" class="w-full h-auto min-w-[320px]" role="img" aria-label="@Model.title: actuals against the monthly ramp, with a you-are-here marker at @Model.thisWeek.Label">
            @for (int g = 0; g <= 4; g++)
            {
                var v = (decimal)(maxY * g / 4);
                <line x1="@padL" x2="@(W - padR)" y1="@Y(v).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="@Y(v).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" stroke="var(--sf-hairline)" stroke-width="1" />
                @Svg.Text(padL - 6, Y(v) + 4, v.ToString("0.#"), anchor: "end")
            }
            @for (int m = 0; m < monthStarts.Count; m++)
            {
                if (monthStarts[m] < 0) { continue; }
                var x = X(monthStarts[m]);
                <line x1="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" x2="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y1="@padT" y2="@(H - padB)" stroke="var(--sf-hairline)" stroke-dasharray="2 4" />
                @Svg.Text(x + 4, H - 8, Model.half.Months[m].Label[..3])
            }
            <path d="@Path(targets)" fill="none" stroke="var(--sf-ink-muted)" stroke-width="2" class="ramp-path" />
            <path d="@Path(actuals)" fill="none" stroke="var(--sf-cyan)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" class="actual-path" />
            @if (hereIdx >= 0)
            {
                var hx = X(hereIdx);
                var hy = hereVal is null ? (hereWeek?.Target is decimal t ? Y(t) : H - padB) : Y(hereVal.Value);
                <g class="marker">
                    <line x1="@hx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" x2="@hx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y1="@padT" y2="@(H - padB)" stroke="var(--sf-copper)" stroke-width="1" />
                    <circle cx="@hx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" cy="@hy.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" r="7" fill="var(--sf-copper)" />
                    @Svg.Text(hx + 10, hy - 10, $"You are here · {Model.thisWeek.Label}", fill: "var(--sf-copper-text)", size: 12, weight: "600")
                </g>
            }
        </svg>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3 caption">
        <span><span class="inline-block w-4 h-[2px] align-middle bg-ink-muted"></span> ramp (weekly target)</span>
        <span><span class="inline-block w-4 h-[3px] align-middle bg-cyan"></span> actuals</span>
        @if (monthEval is not null)
        {
            <span class="ml-auto"><partial name="_StatusChip" model="((MonthStatus)monthEval.Status, (string?)thisMonth.Label[..3])" /></span>
        }
    </div>
</div>
