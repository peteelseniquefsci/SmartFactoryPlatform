@{
    ViewData["Title"] = "Organization";
    var sections = (List<Section>)ViewBag.Sections; var positions = (List<Position>)ViewBag.Positions; var people = (List<Person>)ViewBag.People; var isDev = (bool)ViewBag.IsDevelopment;
}
<h1>Organization</h1>
<p class="text-ink-muted mt-1">Departments, sections, positions, people, reporting lines, assignments and vacancies. Permissions follow the reporting line.</p>
<partial name="_Nav" />

<section class="mt-8">
    <h2>Positions (table of organization)</h2>
    <div class="mt-3 overflow-x-auto"><table class="data-table">
        <thead><tr><th>Position</th><th>Section</th><th>Reports to</th><th class="text-right">Seats</th><th class="text-right">Filled</th><th>Flags</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in positions)
        {
            var filled = people.Count(x => x.PositionId == p.Id && x.Active);
            <tr><td class="font-medium">@p.Title</td><td class="caption">@p.Section?.Name</td><td class="caption">@(p.ReportsTo?.Title ?? positions.FirstOrDefault(x => x.Id == p.ReportsToPositionId)?.Title ?? p.ExternalReportsTo)</td><td class="text-right sf-num">@p.Seats</td><td class="text-right sf-num @(filled < p.Seats ? "text-amber" : "")">@filled</td><td class="caption">@(p.IsManager ? "manager " : "")@(p.IsSectionHead ? "head" : "")</td>
                <td class="text-right"><button type="button" class="btn btn-ghost btn-sm" data-toggle="pos-@p.Id" aria-expanded="false">Edit</button></td></tr>
            <tr id="pos-@p.Id" class="hidden"><td colspan="7">
                <form method="post" action="~/admin/positions/save" class="grid gap-3 md:grid-cols-6 items-end py-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" />
                    <label class="block md:col-span-2"><span class="label text-ink-muted">Title</span><input name="title" value="@p.Title" class="mt-1" required /></label>
                    <label class="block"><span class="label text-ink-muted">Section</span><select name="sectionId" class="mt-1">@foreach (var s in sections) { <option value="@s.Id" selected="@(s.Id == p.SectionId)">@s.Name</option> }</select></label>
                    <label class="block"><span class="label text-ink-muted">Reports to</span><select name="reportsToPositionId" class="mt-1"><option value="">— outside —</option>@foreach (var r in positions.Where(r => r.Id != p.Id)) { <option value="@r.Id" selected="@(r.Id == p.ReportsToPositionId)">@r.Title</option> }</select></label>
                    <label class="block"><span class="label text-ink-muted">Seats</span><input name="seats" type="number" min="0" value="@p.Seats" class="mt-1" /></label>
                    <div class="flex flex-col gap-1"><label class="flex items-center gap-2"><input type="checkbox" name="isSectionHead" value="true" class="w-4 h-4" @(p.IsSectionHead ? "checked" : "") /> Section head</label><label class="flex items-center gap-2"><input type="checkbox" name="isManager" value="true" class="w-4 h-4" @(p.IsManager ? "checked" : "") /> Manager</label></div>
                    <label class="block md:col-span-2"><span class="label text-ink-muted">External superior (if outside the department)</span><input name="externalReportsTo" value="@p.ExternalReportsTo" class="mt-1" /></label>
                    <button class="btn btn-secondary btn-sm" type="submit">Save position</button>
                </form></td></tr>
        }
        </tbody></table></div>
    <details class="mt-3"><summary class="cursor-pointer text-cyan-text">Add a position</summary>
        <form method="post" action="~/admin/positions/save" class="card mt-2 grid gap-3 md:grid-cols-6 items-end">@Html.AntiForgeryToken()
            <label class="block md:col-span-2"><span class="label text-ink-muted">Title</span><input name="title" class="mt-1" required /></label>
            <label class="block"><span class="label text-ink-muted">Section</span><select name="sectionId" class="mt-1">@foreach (var s in sections) { <option value="@s.Id">@s.Name</option> }</select></label>
            <label class="block"><span class="label text-ink-muted">Reports to</span><select name="reportsToPositionId" class="mt-1"><option value="">— outside —</option>@foreach (var r in positions) { <option value="@r.Id">@r.Title</option> }</select></label>
            <label class="block"><span class="label text-ink-muted">Seats</span><input name="seats" type="number" min="0" value="1" class="mt-1" /></label>
            <div class="flex flex-col gap-1"><label class="flex items-center gap-2"><input type="checkbox" name="isSectionHead" value="true" class="w-4 h-4" /> Section head</label><label class="flex items-center gap-2"><input type="checkbox" name="isManager" value="true" class="w-4 h-4" /> Manager</label></div>
            <button class="btn btn-secondary btn-sm" type="submit">Add position</button>
        </form></details>
</section>

<section class="mt-10">
    <h2>People</h2>
    <div class="mt-3 overflow-x-auto"><table class="data-table">
        <thead><tr><th>Employee id</th><th>Name</th><th>Position</th><th>Assignment</th><th>Start</th><th>Status</th><th>Assigned roles</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in people)
        {
            var roles = p.Roles.Select(r => r.Role).ToHashSet();
            <tr><td class="sf-num text-[14px]">@p.EmployeeId</td><td class="font-medium">@p.Name<div class="caption">@p.Email</div></td><td class="caption">@p.Position?.Title</td><td class="caption">@(p.Assignment == Assignment.None ? "—" : p.Assignment.ToString())</td><td class="caption">@Fmt.Date(p.StartDate)</td>
                <td>@if (p.Active) {<span class="chip chip-met">Active</span>} else {<span class="chip chip-none">Left@(p.EndDate is null ? "" : $" {Fmt.Date(p.EndDate.Value)}")</span>}</td>
                <td class="flex gap-1 flex-wrap">
                    <form method="post" action="~/admin/roles/toggle">@Html.AntiForgeryToken()<input type="hidden" name="personId" value="@p.Id" /><input type="hidden" name="role" value="Administrator" /><button class="btn btn-sm @(roles.Contains(PlatformRole.Administrator) ? "btn-secondary border-copper" : "btn-ghost")" type="submit">Administrator</button></form>
                    <form method="post" action="~/admin/roles/toggle">@Html.AntiForgeryToken()<input type="hidden" name="personId" value="@p.Id" /><input type="hidden" name="role" value="HrViewer" /><button class="btn btn-sm @(roles.Contains(PlatformRole.HrViewer) ? "btn-secondary border-copper" : "btn-ghost")" type="submit">HR viewer</button></form>
                </td>
                <td class="text-right"><button type="button" class="btn btn-ghost btn-sm" data-toggle="person-@p.Id" aria-expanded="false">Edit</button></td></tr>
            <tr id="person-@p.Id" class="hidden"><td colspan="8">
                <form method="post" action="~/admin/people/save" class="grid gap-3 md:grid-cols-6 items-end py-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="employeeId" value="@p.EmployeeId" />
                    <label class="block"><span class="label text-ink-muted">Name</span><input name="name" value="@p.Name" class="mt-1" /></label>
                    <label class="block"><span class="label text-ink-muted">Email</span><input name="email" value="@p.Email" class="mt-1" /></label>
                    <label class="block"><span class="label text-ink-muted">Position</span><select name="positionId" class="mt-1">@foreach (var pos in positions) { <option value="@pos.Id" selected="@(pos.Id == p.PositionId)">@pos.Title</option> }</select></label>
                    <label class="block"><span class="label text-ink-muted">Assignment</span><select name="assignment" class="mt-1">@foreach (var a in Enum.GetValues<Assignment>()) { <option value="@a" selected="@(a == p.Assignment)">@a</option> }</select></label>
                    <label class="block"><span class="label text-ink-muted">Start date</span><input name="startDate" type="date" value="@p.StartDate.ToString("yyyy-MM-dd")" class="mt-1" /></label>
                    <label class="block"><span class="label text-ink-muted">End date (leaver → KRA frozen)</span><input name="endDate" type="date" value="@p.EndDate?.ToString("yyyy-MM-dd")" class="mt-1" /></label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="active" value="true" class="w-4 h-4" @(p.Active ? "checked" : "") /> Active</label>
                    <button class="btn btn-secondary btn-sm" type="submit">Save person</button>
                </form></td></tr>
        }
        </tbody></table></div>
    <details class="mt-3"><summary class="cursor-pointer text-cyan-text">Add a person (joiner)</summary>
        <form method="post" action="~/admin/people/save" class="card mt-2 grid gap-3 md:grid-cols-6 items-end">@Html.AntiForgeryToken()
            <label class="block"><span class="label text-ink-muted">Employee id</span><input name="employeeId" class="mt-1" required /></label>
            @if (isDev) { <label class="block"><span class="label text-ink-muted">Name (dev only)</span><input name="name" class="mt-1" /></label><label class="block"><span class="label text-ink-muted">Email</span><input name="email" class="mt-1" /></label> }
            else { <p class="caption md:col-span-2">Name and email come from the company employee-information API.</p> }
            <label class="block"><span class="label text-ink-muted">Position</span><select name="positionId" class="mt-1">@foreach (var pos in positions) { <option value="@pos.Id">@pos.Title</option> }</select></label>
            <label class="block"><span class="label text-ink-muted">Assignment</span><select name="assignment" class="mt-1">@foreach (var a in Enum.GetValues<Assignment>()) { <option value="@a">@a</option> }</select></label>
            <label class="block"><span class="label text-ink-muted">Start date</span><input name="startDate" type="date" class="mt-1" /></label>
            <button class="btn btn-secondary btn-sm" type="submit">Add person</button>
        </form></details>
</section>
