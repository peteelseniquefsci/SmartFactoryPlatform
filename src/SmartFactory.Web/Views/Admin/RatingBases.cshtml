@model List<RatingBasis>
@{
    ViewData["Title"] = "Rating basis library";
}
<h1>Rating basis library</h1>
<p class="text-ink-muted mt-1">The only place rating bands are defined (rule 5.9). RH / RL rate the ratio A/T; AL rates the absolute actual; M is a typed rating. Thresholds of 9 (RH / RL) or −1 (AL) make a band unreachable.</p>
<partial name="_Nav" />
<div class="mt-6 overflow-x-auto"><table class="data-table">
    <thead><tr><th>Key</th><th>Name</th><th>Mode</th><th class="text-right">t5</th><th class="text-right">t4</th><th class="text-right">t3</th><th class="text-right">t2</th><th>Used for</th><th></th></tr></thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr class="@(b.Active ? "" : "text-ink-faint")"><td class="font-medium">@b.Key</td><td>@b.Name</td><td>@b.Mode</td><td class="text-right sf-num">@Fmt.Plain(b.T5)</td><td class="text-right sf-num">@Fmt.Plain(b.T4)</td><td class="text-right sf-num">@Fmt.Plain(b.T3)</td><td class="text-right sf-num">@Fmt.Plain(b.T2)</td><td class="caption">@b.UsedFor@(b.Notes is null ? "" : $" · {b.Notes}")</td>
            <td class="text-right"><button type="button" class="btn btn-ghost btn-sm" data-toggle="basis-@b.Id" aria-expanded="false">Edit</button></td></tr>
        <tr id="basis-@b.Id" class="hidden"><td colspan="9">
            <form method="post" action="/admin/rating-bases/save" class="grid gap-3 md:grid-cols-8 items-end py-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" />
                <label class="block"><span class="label text-ink-muted">Key</span><input name="key" value="@b.Key" class="mt-1" required /></label>
                <label class="block md:col-span-2"><span class="label text-ink-muted">Name</span><input name="name" value="@b.Name" class="mt-1" required /></label>
                <label class="block"><span class="label text-ink-muted">Mode</span><select name="mode" class="mt-1">@foreach (var m in Enum.GetValues<RatingMode>()) { <option value="@m" selected="@(m == b.Mode)">@m</option> }</select></label>
                <label class="block"><span class="label text-ink-muted">t5</span><input name="t5" value="@Fmt.Plain(b.T5)" class="mt-1" /></label>
                <label class="block"><span class="label text-ink-muted">t4</span><input name="t4" value="@Fmt.Plain(b.T4)" class="mt-1" /></label>
                <label class="block"><span class="label text-ink-muted">t3</span><input name="t3" value="@Fmt.Plain(b.T3)" class="mt-1" /></label>
                <label class="block"><span class="label text-ink-muted">t2</span><input name="t2" value="@Fmt.Plain(b.T2)" class="mt-1" /></label>
                <label class="block md:col-span-3"><span class="label text-ink-muted">Used for</span><input name="usedFor" value="@b.UsedFor" class="mt-1" /></label>
                <label class="block md:col-span-3"><span class="label text-ink-muted">Notes</span><input name="notes" value="@b.Notes" class="mt-1" /></label>
                <label class="flex items-center gap-2"><input type="checkbox" name="active" value="true" class="w-4 h-4" @(b.Active ? "checked" : "") /> Active</label>
                <button class="btn btn-secondary btn-sm" type="submit">Save</button>
            </form></td></tr>
    }
    </tbody></table></div>
<details class="mt-3"><summary class="cursor-pointer text-cyan-text">Add a rating basis</summary>
    <form method="post" action="/admin/rating-bases/save" class="card mt-2 grid gap-3 md:grid-cols-8 items-end">@Html.AntiForgeryToken()
        <label class="block"><span class="label text-ink-muted">Key</span><input name="key" class="mt-1" required /></label>
        <label class="block md:col-span-2"><span class="label text-ink-muted">Name</span><input name="name" class="mt-1" required /></label>
        <label class="block"><span class="label text-ink-muted">Mode</span><select name="mode" class="mt-1">@foreach (var m in Enum.GetValues<RatingMode>()) { <option value="@m">@m</option> }</select></label>
        <label class="block"><span class="label text-ink-muted">t5</span><input name="t5" class="mt-1" /></label><label class="block"><span class="label text-ink-muted">t4</span><input name="t4" class="mt-1" /></label><label class="block"><span class="label text-ink-muted">t3</span><input name="t3" class="mt-1" /></label><label class="block"><span class="label text-ink-muted">t2</span><input name="t2" class="mt-1" /></label>
        <label class="block md:col-span-6"><span class="label text-ink-muted">Used for</span><input name="usedFor" class="mt-1" /></label>
        <button class="btn btn-secondary btn-sm md:col-span-2" type="submit">Add</button>
    </form></details>
