@inject Microsoft.Extensions.Options.IOptions<ProductOptions> Product
@inject WebCurrentUserAccessor Current
@{
    var user = Current.User;
    var product = Product.Value;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) || (prefix == "/ascent" && path == "/") ? "nav-link nav-link-active" : "nav-link";
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(title is null ? product.Name : $"{title} · {product.Name}")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script>try{if(localStorage.getItem('sf-theme')==='light')document.documentElement.setAttribute('data-theme','light');}catch(e){}</script>
</head>
<body class="min-h-screen">
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn btn-primary">Skip to content</a>
<div class="md:flex min-h-screen">
    <header class="md:w-60 md:shrink-0 border-b md:border-b-0 md:border-r border-hairline bg-surface">
        <div class="px-6 py-5 flex items-center justify-between md:block">
            <a href="/" class="no-underline text-ink">
                <div class="font-display font-bold text-[18px] leading-[22px]">@product.Name</div>
                <div class="caption mt-1">Progress as a shared climb</div>
            </a>
            <button type="button" class="btn btn-ghost btn-sm md:hidden" data-theme-toggle aria-label="Switch theme">Theme</button>
        </div>
        @if (user is not null)
        {
            <nav class="px-3 pb-4 flex flex-wrap gap-1 md:block" aria-label="Main">
                <a class="@Active("/ascent")" href="/">Ascent</a>
                <a class="@Active("/kra")" href="/kra">My KRA</a>
                <a class="@Active("/week")" href="/week">My week</a>
                @if (user.IsHeadOrManager || user.IsAdministrator)
                {
                    <a class="@Active("/team")" href="/team">Team view</a>
                }
                <a class="@Active("/cascade")" href="/cascade">Cascade</a>
                @if (user.IsHeadOrManager || user.IsAdministrator)
                {
                    <a class="@Active("/weekbyweek")" href="/weekbyweek">Week by week</a>
                    <a class="@Active("/approvals")" href="/approvals">Approvals</a>
                }
                @if (user.Is(PlatformRole.Manager) || user.Is(PlatformRole.HrViewer) || user.IsAdministrator)
                {
                    <a class="@Active("/exports")" href="/exports">Exports</a>
                }
                @if (user.IsAdministrator)
                {
                    <a class="@Active("/admin")" href="/admin">Admin</a>
                }
            </nav>
            <div class="hidden md:block px-6 py-4 border-t border-hairline caption">
                <div class="text-ink">@user.Name</div>
                <div>@user.Person.Position?.Title</div>
                <div class="mt-3 flex items-center gap-2">
                    <button type="button" class="btn btn-ghost btn-sm" data-theme-toggle>Switch theme</button>
                    <form method="post" action="/account/sign-out" class="inline">@Html.AntiForgeryToken()<button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form>
                </div>
            </div>
        }
    </header>
    <main id="main" class="flex-1 min-w-0 px-6 md:px-12 py-6 md:py-12">
        @if (TempData["Error"] is string err)
        {
            <div class="flash flash-error" role="alert">@err</div>
        }
        @if (TempData["Ok"] is string ok)
        {
            <div class="flash flash-ok" role="status">@ok</div>
        }
        @RenderBody()
    </main>
</div>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
