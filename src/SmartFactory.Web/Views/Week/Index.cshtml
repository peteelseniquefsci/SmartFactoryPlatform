@model WeekPageViewModel
@{
    ViewData["Title"] = Model.IsOwner ? "My week" : $"{Model.Owner.Name} · {Model.Week.Label}";
    var ev = Model.Evaluation; var week = Model.Week; var month = week.FiscalMonth!;
    var personQ = Model.IsOwner ? "" : $"&person={Model.Owner.Id}";
    var weeklySlots = ev.ActiveSlots.Where(s => s.Slot.Aggregation != Aggregation.MANUAL).ToList();
    var manualSlots = ev.ActiveSlots.Where(s => s.Slot.Aggregation == Aggregation.MANUAL || s.Basis?.Mode == RatingMode.M).ToList();
    var isCurrent = week.Id == Model.ThisWeek.Id;
    var monthTotal = ev.MonthTotals.First(t => t.Month.Index == month.Index);
}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1>@(Model.IsOwner ? "My week" : Model.Owner.Name)</h1>
        <p class="text-ink-muted mt-1">@week.Label · @Fmt.Range(week.StartDate, week.EndDate) · week @week.K of @week.N in @month.Label · @Model.Half.Label@(isCurrent ? " · this week" : "")</p>
    </div>
    <nav class="flex items-center gap-2" aria-label="Work week">
        @if (Model.Previous is not null) { <a class="btn btn-ghost btn-sm" href="~/week?week=@Model.Previous.Label@personQ">← @Model.Previous.Label</a> }
        <a class="btn btn-secondary btn-sm @(isCurrent ? "border-copper" : "")" href="~/week?week=@Model.ThisWeek.Label@personQ">This week</a>
        @if (Model.Next is not null) { <a class="btn btn-ghost btn-sm" href="~/week?week=@Model.Next.Label@personQ">@Model.Next.Label →</a> }
    </nav>
</div>

@if (!Model.IsOwner)
{
    <p class="mt-3"><a href="~/kra/person/@Model.Owner.Id" class="text-cyan-text">Open KRA</a> · <partial name="_ModeBadge" model="Model.Kra" /></p>
}

@if (Model.Kra.Mode == DefinitionMode.Setup)
{
    <div class="flash flash-ok mt-6 !border-amber !bg-amber-soft !text-amber" role="status">This KRA is still in SETUP. Weekly actuals can be entered, but the definitions are not approved yet. <a href="~/kra" class="underline">Finish setup</a>.</div>
}

@if (weeklySlots.Count == 0 && manualSlots.Count == 0)
{
    <div class="panel mt-6"><h2>No active slots</h2><p class="text-ink-muted mt-2">Add slots in <a href="~/kra" class="text-cyan-text">My KRA</a> first. A slot is active when its measure is non-empty.</p></div>
}

@if (weeklySlots.Count > 0)
{
    <form method="post" action="~/week/save" class="mt-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="KraId" value="@Model.Kra.Id" /><input type="hidden" name="Week" value="@week.Label" />
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2>This week's actuals</h2>
            <div class="caption">Enter by Friday. Month status beside each slot follows rule 5.7 and concludes early only when the outcome cannot change.</div>
        </div>
        <div class="mt-4 space-y-3">
            @{ int i = 0; }
            @foreach (var s in weeklySlots)
            {
                var idx = i++; var w = s.Week(week.Label)!; var me = s.Month(month.Index)!;
                var remarks = s.Slot.Remarks.Where(r => r.WorkWeekId == week.Id).OrderBy(r => r.CreatedAt).ToList();
                <div class="card">
                    <input type="hidden" name="Rows[@idx].SlotNumber" value="@s.Slot.SlotNumber" />
                    <div class="grid gap-3 md:grid-cols-[1fr_140px_160px_120px_160px] items-end">
                        <div>
                            <div class="font-medium">@s.Slot.Measure</div>
                            <div class="caption">Slot @s.Slot.SlotNumber · @s.Slot.Weight.ToString("0.##")% · @s.Slot.Aggregation · @s.Slot.WeeklyRule · @s.Slot.RatingBasis?.Key@(w.Source is ResultSource src && src != ResultSource.Typed ? $" · fed by {src}" : "")</div>
                        </div>
                        <div>
                            <div class="label text-ink-muted">Weekly target</div>
                            @if (s.Slot.WeeklyRule == WeeklyRule.MANUAL)
                            {
                                <input name="Rows[@idx].ManualTarget" value="@Fmt.Plain(w.Target)" inputmode="decimal" class="mt-1" @(Model.CanEnter ? "" : "disabled") aria-label="Weekly target for slot @s.Slot.SlotNumber" />
                            }
                            else
                            {
                                <div class="number-m mt-1">@Fmt.Num(w.Target, 3)</div>
                            }
                        </div>
                        <label class="block"><span class="label text-ink-muted">Actual</span>
                            <input name="Rows[@idx].Actual" value="@Fmt.Plain(w.Actual)" inputmode="decimal" class="mt-1 text-[18px] font-display" @(Model.CanEnter ? "" : "disabled") /></label>
                        <div>
                            <div class="label text-ink-muted">Judgement</div>
                            <div class="mt-2"><partial name="_JudgementChip" model="(w.Judgement, (string?)null)" /></div>
                        </div>
                        <div>
                            <div class="label text-ink-muted">@month.Label[..3] status</div>
                            <div class="mt-2 flex items-center gap-2"><partial name="_StatusChip" model="(me.Status, (string?)null)" />
                                <span class="caption">@Fmt.Num(me.Actual, 2) vs @Fmt.Num(me.Plan, 2)@(me.Final ? " · final" : "")</span></div>
                        </div>
                    </div>
                    <div class="mt-3 grid gap-3 md:grid-cols-[1fr_auto] items-start">
                        <div>
                            @if (remarks.Count > 0)
                            {
                                <ul class="space-y-1">
                                    @foreach (var r in remarks) { <li class="caption"><span class="text-ink">@r.Author?.Name</span> · @Fmt.Date(r.CreatedAt): <span class="text-ink">@r.Text</span></li> }
                                </ul>
                            }
                            @if (Model.CanEnter)
                            {
                                <input name="Rows[@idx].Remark" placeholder="Add a remark for @week.Label (optional)" class="mt-2" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.CanEnter)
        {
            <div class="sticky bottom-0 py-3 bg-surface/90 backdrop-blur mt-4 flex items-center gap-3">
                <button type="submit" class="btn btn-primary">Save week</button>
                <span class="caption">@month.Label total so far: <partial name="_Rating" model="(monthTotal.Total, 2, monthTotal.Provisional)" /></span>
            </div>
        }
    </form>
}

@if (manualSlots.Count > 0)
{
    <form method="post" action="~/week/save-month" class="mt-8">
        @Html.AntiForgeryToken()
        <input type="hidden" name="KraId" value="@Model.Kra.Id" /><input type="hidden" name="MonthIndex" value="@month.Index" /><input type="hidden" name="ReturnWeek" value="@week.Label" />
        <h2>Manual values for @month.Label</h2>
        <p class="caption mt-1">Read only when aggregation is MANUAL (actual) or the basis mode is M (typed rating 1–5).</p>
        <div class="mt-4 space-y-3">
            @{ int j = 0; }
            @foreach (var s in manualSlots)
            {
                var idx = j++; var me = s.Month(month.Index)!;
                <div class="card grid gap-3 md:grid-cols-[1fr_160px_160px_160px] items-end">
                    <input type="hidden" name="Rows[@idx].SlotNumber" value="@s.Slot.SlotNumber" />
                    <div><div class="font-medium">@s.Slot.Measure</div><div class="caption">Slot @s.Slot.SlotNumber · plan @Fmt.Num(me.Plan, 2) · @s.Slot.RatingBasis?.Key</div></div>
                    @if (s.Slot.Aggregation == Aggregation.MANUAL && s.Basis?.Mode != RatingMode.M)
                    {
                        <label class="block"><span class="label text-ink-muted">Monthly actual</span><input name="Rows[@idx].ManualActual" value="@Fmt.Plain(me.ManualActual)" inputmode="decimal" class="mt-1" @(Model.CanEnter ? "" : "disabled") /></label>
                    }
                    else { <div></div> }
                    @if (s.Basis?.Mode == RatingMode.M)
                    {
                        <label class="block"><span class="label text-ink-muted">Typed rating (1–5)</span><input name="Rows[@idx].ManualRating" value="@me.ManualRating" inputmode="numeric" min="1" max="5" type="number" class="mt-1" @(Model.CanEnter ? "" : "disabled") /></label>
                    }
                    else { <div></div> }
                    <div><div class="label text-ink-muted">Rating</div><div class="mt-1"><partial name="_Rating" model="((decimal?)me.Rating, 0, me.Provisional)" /></div></div>
                </div>
            }
        </div>
        @if (Model.CanEnter) { <button type="submit" class="btn btn-secondary mt-4">Save manual values</button> }
    </form>
}

@if (Model.CanRemark && !Model.IsOwner && weeklySlots.Count > 0)
{
    <form method="post" action="~/week/remark" class="panel mt-8 grid gap-3 md:grid-cols-[200px_1fr_auto] items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="kraId" value="@Model.Kra.Id" /><input type="hidden" name="week" value="@week.Label" />
        <label class="block"><span class="label text-ink-muted">Slot</span><select name="slotNumber" class="mt-1">@foreach (var s in ev.ActiveSlots) { <option value="@s.Slot.SlotNumber">@s.Slot.SlotNumber · @s.Slot.Measure</option> }</select></label>
        <label class="block"><span class="label text-ink-muted">Remark on @week.Label</span><input name="text" class="mt-1" required /></label>
        <button class="btn btn-secondary" type="submit">Add remark</button>
    </form>
}
